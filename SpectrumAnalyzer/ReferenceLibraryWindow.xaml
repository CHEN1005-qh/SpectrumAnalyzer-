<Window x:Class="SpectrumAnalyzer.ReferenceLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ScottPlot="clr-namespace:ScottPlot;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Title="📚 标准参考库" Height="720" Width="1350" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 次要辅助按钮模板 -->
        <ControlTemplate x:Key="SecondaryButtonTemplate" TargetType="Button">
            <Border x:Name="BtnBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#F8FAFC"/>
                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#94A3B8"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="DangerButtonTemplate" TargetType="Button">
            <Border x:Name="BtnBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#FFE3E3"/>
                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#FF8787"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#FFC9C9"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template" Value="{StaticResource SecondaryButtonTemplate}"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFF5F5"/>
            <Setter Property="Foreground" Value="#E03131"/>
            <Setter Property="BorderBrush" Value="#FFA8A8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template" Value="{StaticResource DangerButtonTemplate}"/>
        </Style>

        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F1F5F9"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. 顶部操作工具栏 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="15,8">
            <DockPanel>
                <TextBlock Text="📚 标准参考库" Foreground="#0F172A" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="BtnRefresh" Content="🔄 刷新" Click="BtnRefresh_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="12,5"/>
                    <Button x:Name="BtnImport" Content="📥 导入" Click="BtnImport_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="12,5" ToolTip="从 JSON 文件导入参考谱到标准库"/>
                    <Button x:Name="BtnExport" Content="📤 导出" Click="BtnExport_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="12,5" ToolTip="将标准参考库导出为 JSON 文件"/>
                    <Button x:Name="BtnDelete" Content="🗑 删除选中" Click="BtnDelete_Click" Style="{StaticResource DangerButtonStyle}" Margin="0,0,6,0" Padding="12,5"/>
                    <Button x:Name="BtnCategory" Content="🗂 分类管理" Click="BtnCategory_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="12,5"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. 筛选栏 -->
        <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="15,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="分类:" Foreground="#475569" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="CmbCategory" Width="180" Height="28" SelectionChanged="CmbCategory_SelectionChanged" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <TextBlock Text="搜索:" Foreground="#475569" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="TxtSearch" Width="220" Height="28" VerticalContentAlignment="Center" TextChanged="TxtSearch_TextChanged" ToolTip="按物质名称、化学式或 CAS 号模糊搜索"/>
                <TextBlock x:Name="TxtCount" Foreground="#64748B" FontSize="12" VerticalAlignment="Center" Margin="15,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 3. 主区域：左侧列表 + 右侧预览 -->
        <Grid Grid.Row="2" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="DgRef" Grid.Column="0" AutoGenerateColumns="False"
                      SelectionMode="Extended" IsReadOnly="False" FontSize="13"
                      SelectionChanged="DgRef_SelectionChanged"
                      MouseDoubleClick="DgRef_MouseDoubleClick"
                      Style="{StaticResource ModernDataGridStyle}"
                      RowHeight="42">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="" Width="40" Binding="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" IsReadOnly="True"/>
                    <DataGridTextColumn Header="物质名称" Binding="{Binding SubstanceName}" Width="130" IsReadOnly="True"/>
                    <DataGridTextColumn Header="化学式" Binding="{Binding ChemicalFormula}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="CAS号" Binding="{Binding CasNumber}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="分类" Binding="{Binding CategoryDisplay}" Width="130" IsReadOnly="True"/>
                    <DataGridTextColumn Header="激发波长" Binding="{Binding ExcitationWavelength}" Width="90" IsReadOnly="True"/>
                    <DataGridTextColumn Header="特征指纹峰位" Binding="{Binding PeaksJson_Display}" Width="150" IsReadOnly="True"/>
                    <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt}" Width="135" IsReadOnly="True"/>
                    <DataGridTextColumn Header="备注" Binding="{Binding Note_Display}" Width="150" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- 右侧谱图预览 -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="TxtPreviewTitle" Text="选择参考谱以预览" Foreground="#475569"
                               FontSize="12" FontWeight="SemiBold" Margin="4,2,4,6" TextTrimming="CharacterEllipsis"/>
                    <ScottPlot:WpfPlot Grid.Row="1" x:Name="PreviewPlot" />
                    <TextBlock Grid.Row="2" x:Name="TxtPreviewInfo" Text="" Foreground="#64748B" FontSize="11" Margin="4,4,4,0" TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. 底部状态提示 -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="15,6">
            <TextBlock x:Name="TxtStatus" Text="就绪" Foreground="#64748B" FontSize="11"/>
        </Border>
    </Grid>
</Window>