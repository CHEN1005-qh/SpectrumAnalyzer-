<Window x:Class="SpectrumAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ScottPlot="clr-namespace:ScottPlot;assembly=ScottPlot.WPF" 
        mc:Ignorable="d"
        Title="拉曼光谱分析系统 v1.5" Height="780" Width="1350" WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- ========================================================== -->
        <!-- 核心提取 1：独立 ControlTemplate 声明区（彻底规避嵌套解析冲突） -->
        <!-- ========================================================== -->

        <!-- 标签页模板 -->
        <ControlTemplate x:Key="SegmentedTabTemplate" TargetType="RadioButton">
            <Border x:Name="TabBorder" 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    CornerRadius="6" 
                    Margin="2"
                    SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="TabBorder" Property="Background" Value="#FFFFFF"/>
                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="#E2E8F0"/>
                    <Setter Property="Foreground" Value="#0F172A"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="TabBorder" Property="Cursor" Value="Hand"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 次要辅助按钮模板 -->
        <ControlTemplate x:Key="SecondaryButtonTemplate" TargetType="Button">
            <Border x:Name="BtnBorder" 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="6" 
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#F8FAFC"/>
                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#94A3B8"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 主要高亮按钮模板 -->
        <ControlTemplate x:Key="PrimaryButtonTemplate" TargetType="Button">
            <Border x:Name="BtnBorder" 
                    Background="{TemplateBinding Background}" 
                    CornerRadius="6" 
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#0256CF"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#013FA3"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 警示/删除按钮模板 -->
        <ControlTemplate x:Key="DangerButtonTemplate" TargetType="Button">
            <Border x:Name="BtnBorder" 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="6" 
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#FFE3E3"/>
                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#FF8787"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#FFC9C9"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 绿色成功按钮模板 -->
        <ControlTemplate x:Key="SuccessButtonTemplate" TargetType="Button">
            <Border x:Name="BtnBorder" 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="6" 
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#D1FAE5"/>
                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#6EE7B7"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 亮橙色引擎比对按钮模板 -->
        <ControlTemplate x:Key="BrandButtonTemplate" TargetType="Button">
            <Border x:Name="BtnBorder" 
                    Background="{TemplateBinding Background}" 
                    CornerRadius="6" 
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#EA580C"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>


        <!-- ========================================================== -->
        <!-- 核心提取 2：纯净 Style 声明区（仅平面引用模板，无任何嵌套） -->
        <!-- ========================================================== -->

        <Style x:Key="SegmentedTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template" Value="{StaticResource SegmentedTabTemplate}"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template" Value="{StaticResource SecondaryButtonTemplate}"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0D6EFD"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template" Value="{StaticResource PrimaryButtonTemplate}"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFF5F5"/>
            <Setter Property="Foreground" Value="#E03131"/>
            <Setter Property="BorderBrush" Value="#FFA8A8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template" Value="{StaticResource DangerButtonTemplate}"/>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#ECFDF5"/>
            <Setter Property="Foreground" Value="#047857"/>
            <Setter Property="BorderBrush" Value="#A7F3D0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template" Value="{StaticResource SuccessButtonTemplate}"/>
        </Style>

        <Style x:Key="BrandButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F97316"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template" Value="{StaticResource BrandButtonTemplate}"/>
        </Style>

        <Style x:Key="ModernDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F1F5F9"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 主容器，分离为上部工作区和底置统一状态栏 -->
    <Grid Background="#F8FAFC">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <!-- 底部统一状态栏 -->
        </Grid.RowDefinitions>

        <!-- 核心工作区 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <!-- 左侧：数据流卡片管理宽度 -->
                <ColumnDefinition Width="470"/>
                <!-- 右侧：绘图与主操作区 -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 【左侧：数据库数据管理】 -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
                <DockPanel Margin="15">
                    <!-- 1. 顶部基础操作（自适应排布，消除文字截断缺陷） -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 主功能入口 -->
                        <Button x:Name="BtnOpen" Grid.Column="0" Content="📂 打开光谱数据" Style="{StaticResource PrimaryButtonStyle}" 
                                Height="32" Padding="15,0" HorizontalAlignment="Left" Click="BtnOpen_Click" />

                        <!-- 工具控制组 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnReset" Content="🔄 重置" Click="BtnReset_Click" Style="{StaticResource SecondaryButtonStyle}" Height="32" Padding="8,0" Margin="0,0,5,0"/>
                            <Button x:Name="BtnDelete" Content="🗑 删除" Click="BtnDelete_Click" Style="{StaticResource DangerButtonStyle}" Height="32" Padding="8,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- 2. 实测光谱库标题 + 打开参考库独立窗口按钮 -->
                    <Border DockPanel.Dock="Top" Background="#F1F5F9" CornerRadius="8" Padding="10,6" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📊 实测光谱库" Foreground="#0F172A" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="BtnReferenceLibrary" Content="📚 标准参考库" Click="BtnReferenceLibrary_Click"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="14,5"
                                    ToolTip="打开独立的标准参考库窗口"/>
                        </Grid>
                    </Border>

                    <!-- 3. 数据表格 -->
                    <DataGrid x:Name="DgMain" AutoGenerateColumns="False" 
                              IsReadOnly="False" SelectionMode="Extended"
                              SelectionChanged="DgMain_SelectionChanged" 
                              Style="{StaticResource ModernDataGridStyle}"
                              RowHeight="42" FontSize="13" MouseDoubleClick="DgMain_MouseDoubleClick">
                        <!-- 数据列通过后台 RefreshMainList() 动态注入 -->
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- 【右侧：主操作条 + 绘图区】 -->
            <Grid Grid.Column="1" Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- 顶部精致工具条 -->
                    <RowDefinition Height="*"/>
                    <!-- 核心绘图卡片 -->
                </Grid.RowDefinitions>

                <!-- 1. 顶部操作工具条 -->
                <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,15">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.04"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 全部功能按钮合并到右侧一组，按流程顺序排列 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnSettings" Content="⚙ 算法参数" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,6,0" Padding="12,5" Click="BtnSettings_Click"/>
                            <Button x:Name="BtnDoPreprocess" Content="✨ 预处理" Click="BtnDoPreprocess_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,6,0" 
                                    Padding="15,5" FontWeight="Bold"/>
                            <Button Content="➕ 入库" Style="{StaticResource SuccessButtonStyle}" Margin="0,0,8,0" Padding="12,5" Click="BtnAddToLibrary_Click"/>
                            <Button x:Name="BtnMatch" Content="🔍 智能比对" Click="BtnMatch_Click" Style="{StaticResource BrandButtonStyle}" Padding="18,5"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. 核心绘图卡片区 -->
                <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.04"/>
                    </Border.Effect>
                    <ScottPlot:WpfPlot x:Name="MainPlot" />
                </Border>
            </Grid>
        </Grid>

        <!-- 【统一底部状态栏】（整合两端状态与提示，提高信息密度） -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="15,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- 提示区 -->
                    <ColumnDefinition Width="*"/>
                    <!-- 文件加载名 -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- 预处理运算状态 -->
                </Grid.ColumnDefinitions>

                <!-- 1. 操作提示 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💡 操作指南：" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="双击左侧实测列表查看光谱元数据；多选列表可同屏叠加对比；双击图表区重置坐标。" Foreground="#64748B" FontSize="11"/>
                </StackPanel>

                <!-- 2. 核心加载物理数据源信息 -->
                <TextBlock x:Name="TxtFileInfo" Grid.Column="1" Text="尚未加载拉曼文件" 
                           Foreground="#0F172A" FontSize="11" FontWeight="SemiBold" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- 3. 后台算法状态反馈 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2">
                        <TextBlock x:Name="TxtPreprocessStatus" Text="状态: 就绪" Foreground="#475569" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>