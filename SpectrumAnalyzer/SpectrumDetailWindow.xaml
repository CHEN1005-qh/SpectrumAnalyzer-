<Window x:Class="SpectrumAnalyzer.SpectrumDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="实测光谱详细信息与元数据" SizeToContent="Height" Width="490" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" 
        Background="#F8FAFC">

    <Window.Resources>
        <!-- ========================================================== -->
        <!-- 1. 独立 ControlTemplate 声明区（规避嵌套解析冲突与编译错误） -->
        <!-- ========================================================== -->

        <!-- 次要辅助/取消按钮模板 -->
        <ControlTemplate x:Key="SecondaryButtonTemplate" TargetType="Button">
            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#F8FAFC"/>
                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#94A3B8"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 主要高亮应用按钮模板 -->
        <ControlTemplate x:Key="PrimaryButtonTemplate" TargetType="Button">
            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#0256CF"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#013FA3"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ========================================================== -->
        <!-- 2. Style 平铺绑定定义区 -->
        <!-- ========================================================== -->

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template" Value="{StaticResource SecondaryButtonTemplate}"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0D6EFD"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template" Value="{StaticResource PrimaryButtonTemplate}"/>
        </Style>

        <!-- 现代单行输入框样式 (支持只读状态灰底化与聚焦发光) -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="4" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#0D6EFD"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 标题 -->
            <RowDefinition Height="*"/>
            <!-- 表单卡片 -->
            <RowDefinition Height="Auto"/>
            <!-- 动作控制 -->
        </Grid.RowDefinitions>

        <!-- 1. 顶部标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="实测光谱元数据详情" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="查看或修约当前导入的实测光谱物理元数据与仪器测定参数" FontSize="11" Foreground="#6C757D" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- 2. 表单配置区（扁平卡片布局） -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15,10">
            <StackPanel>
                <!-- 2.1 双列参数矩阵 -->
                <UniformGrid Columns="2">
                    <StackPanel Margin="5">
                        <TextBlock Text="样品名称:" Foreground="#64748B" FontSize="11" Margin="2,0,0,4"/>
                        <TextBox x:Name="TxtName" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="分子式 / 理想化学式:" Foreground="#64748B" FontSize="11" Margin="2,0,0,4"/>
                        <TextBox x:Name="TxtFormula" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="采集时间 (只读):" Foreground="#64748B" FontSize="11" Margin="2,0,0,4"/>
                        <TextBox x:Name="TxtAcquiredAt" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="数据点数 (只读):" Foreground="#64748B" FontSize="11" Margin="2,0,0,4"/>
                        <TextBox x:Name="TxtPoints" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="激光波长 (nm):" Foreground="#64748B" FontSize="11" Margin="2,0,0,4"/>
                        <TextBox x:Name="TxtLaser" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="光栅刻线:" Foreground="#64748B" FontSize="11" Margin="2,0,0,4"/>
                        <TextBox x:Name="TxtGrating" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="激光功率 (mW):" Foreground="#64748B" FontSize="11" Margin="2,0,0,4"/>
                        <TextBox x:Name="TxtPower" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="积分时间 (s):" Foreground="#64748B" FontSize="11" Margin="2,0,0,4"/>
                        <TextBox x:Name="TxtTime" Style="{StaticResource ModernTextBoxStyle}"/>
                    </StackPanel>
                </UniformGrid>

                <!-- 2.2 处理方法（单行） -->
                <StackPanel Margin="5,10,5,5">
                    <TextBlock Text="数字信号处理方法:" Foreground="#64748B" FontSize="11" Margin="2,0,0,4"/>
                    <TextBox x:Name="TxtMethod" Style="{StaticResource ModernTextBoxStyle}"/>
                </StackPanel>

                <!-- 2.3 学术警告与备注（多行大文本区，使用合规 Border 包裹实现圆角） -->
                <StackPanel Margin="5,10,5,5">
                    <TextBlock Text="物理特性 / XRD物相验证说明 / 学术备注:" Foreground="#1E293B" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,5"/>
                    <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Background="White">
                        <TextBox x:Name="TxtNote" Height="100" TextWrapping="Wrap" AcceptsReturn="True" 
                                 VerticalContentAlignment="Top" Padding="6" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 3. 底部动作区 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Width="75" Height="28" IsCancel="True" Margin="0,0,10,0"/>
            <Button Content="保存修改" Style="{StaticResource PrimaryButtonStyle}" Width="95" Height="28" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>