<Window x:Class="SpectrumAnalyzer.MatchResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="双引擎智能比对结果" Height="520" Width="900" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC">

    <Window.Resources>
        <!-- 1. 独立列标题样式 (消除 Setter.Value 嵌套隐患) -->
        <Style x:Key="ModernGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <!-- 2. 精细化表格样式 -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource ModernGridHeaderStyle}"/>
        </Style>

        <!-- 3. 数据列文本对齐与内边距样式 (解决紧贴边缘的问题) -->
        <!-- 左对齐文本单元格 -->
        <Style x:Key="LeftAlignCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>

        <!-- 居中对齐文本单元格 -->
        <Style x:Key="CenterAlignCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>

        <!-- 综合相似度 (加粗高亮蓝色) 单元格 -->
        <Style x:Key="BoldHighlightCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Foreground" Value="#0D6EFD"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- 4. 专属次要辅助按钮样式 -->
        <ControlTemplate x:Key="SecondaryButtonTemplate" TargetType="Button">
            <Border x:Name="BtnBorder" 
                    Background="{TemplateBinding Background}" 
                    BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="6" 
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#F8FAFC"/>
                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#94A3B8"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template" Value="{StaticResource SecondaryButtonTemplate}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 顶部标题与说明 -->
            <RowDefinition Height="*"/>
            <!-- 核心表格区 -->
            <RowDefinition Height="Auto"/>
            <!-- 底部动作 -->
        </Grid.RowDefinitions>

        <!-- 1. 顶部标题区 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="🔍 智能比对结果 (特征峰 &amp; 全谱双轨分析)" FontSize="18" FontWeight="Bold" Foreground="#212529"/>
            <TextBlock Text="💡 操作提示：单击列表中对应的条目，主窗口光谱图上将自动叠加投影该物质的特征指纹参考线。" FontSize="11" Foreground="#6C757D" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- 2. 数据表格（包裹于卡片式卡槽中以提升整体质感） -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.04"/>
            </Border.Effect>

            <DataGrid x:Name="DgResults" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      SelectionChanged="DgResults_SelectionChanged" 
                      SelectionMode="Single"
                      Style="{StaticResource ModernDataGrid}" 
                      FontSize="13.5" 
                      RowHeight="32">
                <DataGrid.Columns>
                    <!-- 物质名称 -->
                    <DataGridTextColumn Header="标准物质名称" Binding="{Binding Name}" Width="160" 
                                        ElementStyle="{StaticResource LeftAlignCell}"/>

                    <!-- 化学式 -->
                    <DataGridTextColumn Header="化学式" Binding="{Binding Formula}" Width="110" 
                                        ElementStyle="{StaticResource LeftAlignCell}"/>

                    <!-- 综合得分（平均分，醒目高亮） -->
                    <DataGridTextColumn Header="综合相似度 (%)" Binding="{Binding CombinedScore, StringFormat={}{0:F1}}" Width="135" 
                                        ElementStyle="{StaticResource BoldHighlightCell}"/>

                    <!-- 特征峰得分 -->
                    <DataGridTextColumn Header="特征峰得分 (%)" Binding="{Binding PeakScore, StringFormat={}{0:F1}}" Width="120" 
                                        ElementStyle="{StaticResource CenterAlignCell}"/>

                    <!-- 全谱 HQI 得分 -->
                    <DataGridTextColumn Header="全谱相似度 (HQI%)" Binding="{Binding HqiScore, StringFormat={}{0:F1}}" Width="145" 
                                        ElementStyle="{StaticResource CenterAlignCell}"/>

                    <!-- 命中的峰值比例 -->
                    <DataGridTextColumn Header="特征峰命中数" Binding="{Binding PeakMatchRatio}" Width="120" 
                                        ElementStyle="{StaticResource CenterAlignCell}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 3. 底部关闭动作 -->
        <Button Grid.Row="2" Content="关闭窗口" Click="BtnClose_Click" Style="{StaticResource SecondaryButtonStyle}" 
                Width="90" Height="30" HorizontalAlignment="Right" Margin="0,15,0,0"/>
    </Grid>
</Window>