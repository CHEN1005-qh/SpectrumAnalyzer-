<Window x:Class="SpectrumAnalyzer.CategoryManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="标准库分类管理" Width="500" Height="470"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F8FAFC">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="🗂 标准库分类管理" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="多级树状分类：左侧选中分类后可重命名 / 删除 / 上下调整顺序，也可新增顶级或子分类" FontSize="11" Foreground="#6C757D" Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 分类树 -->
        <TreeView x:Name="TvCategories" Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="1" Background="White"
                  Padding="4" FontSize="13">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="True"/>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding Name}" Margin="2,1"/>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- 名称输入 + 新增/重命名 -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="名称:" VerticalAlignment="Center" Foreground="#475569" FontSize="12"/>
            <TextBox x:Name="TxtName" Grid.Column="1" Margin="6,0" Height="28" VerticalContentAlignment="Center" Padding="6,0"/>
            <Button Grid.Column="2" Content="➕ 新增顶级" Click="BtnAddTop_Click" Padding="8,4" Margin="0,0,6,0"/>
            <Button Grid.Column="3" Content="新增子类" Click="BtnAddChild_Click" Padding="8,4" Margin="0,0,6,0"/>
            <Button Grid.Column="4" Content="✏ 重命名" Click="BtnRename_Click" Padding="8,4"/>
        </Grid>

        <!-- 维护操作 + 关闭 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="🗑 删除选中" Click="BtnDelete_Click" Padding="10,5" Margin="0,0,6,0"/>
            <Button Content="⬆ 上移" Click="BtnUp_Click" Padding="10,5" Margin="0,0,6,0"/>
            <Button Content="⬇ 下移" Click="BtnDown_Click" Padding="10,5" Margin="0,0,6,0"/>
            <Button Content="✔ 完成" Click="BtnDone_Click" Padding="14,5" FontWeight="Bold"
                    Background="#10B981" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>