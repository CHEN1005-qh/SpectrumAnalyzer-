<Window x:Class="SpectrumAnalyzer.CsvImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CSV 智能导入向导" Height="560" Width="460" 
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC">

    <Window.Resources>
        <!-- 1. 专属现代文本输入框样式 (带聚焦高亮) -->
        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#0D6EFD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 2. 专属主要高亮按钮样式 -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#0D6EFD"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#0256CF"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#013FA3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 3. 专属次要辅助按钮样式 -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#94A3B8"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 标题 -->
            <RowDefinition Height="Auto"/>
            <!-- 参数配置卡片 -->
            <RowDefinition Height="*"/>
            <!-- 数据预览 -->
            <RowDefinition Height="Auto"/>
            <!-- 动作按钮 -->
        </Grid.RowDefinitions>

        <!-- 1. 顶部标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="CSV 导入参数配置" FontSize="18" FontWeight="Bold" Foreground="#212529"/>
            <TextBlock Text="向导将帮助您自适应解析不同拉曼光谱仪导出的表格数据" FontSize="11" Foreground="#6C757D" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- 2. 参数配置区（扁平卡片布局） -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 跳过行数 -->
                <TextBlock Text="跳过文件头行数:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="5,6" Foreground="#475569" FontWeight="Medium" FontSize="12"/>
                <TextBox x:Name="TxtSkipLines" Style="{StaticResource ModernTextBoxStyle}" Grid.Row="0" Grid.Column="1" Text="0" Width="100" HorizontalAlignment="Left" Margin="10,6"
                         ToolTip="导入解析时跳过的非数据行数（如仪器预设的注释说明头）"/>

                <!-- 分隔符 -->
                <TextBlock Text="数据列分隔符:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="5,6" Foreground="#475569" FontWeight="Medium" FontSize="12"/>
                <ComboBox x:Name="CmbDelimiter" Grid.Row="1" Grid.Column="1" Width="120" HorizontalAlignment="Left" Margin="10,6" SelectedIndex="0" VerticalContentAlignment="Center" Height="28">
                    <ComboBoxItem Content="," IsSelected="True"/>
                    <ComboBoxItem Content=";"/>
                    <ComboBoxItem Content="Tab"/>
                </ComboBox>

                <!-- X轴所在列 -->
                <TextBlock Text="X轴 (波数) 列索引:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="5,6" Foreground="#475569" FontWeight="Medium" FontSize="12"/>
                <TextBox x:Name="TxtXColumn" Style="{StaticResource ModernTextBoxStyle}" Grid.Row="2" Grid.Column="1" Text="0" Width="100" HorizontalAlignment="Left" Margin="10,6"
                         ToolTip="目标数据列的零基索引（第一列为 0，第二列为 1，以此类推）"/>

                <!-- Y轴所在列 -->
                <TextBlock Text="Y轴 (强度) 列索引:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="5,6" Foreground="#475569" FontWeight="Medium" FontSize="12"/>
                <TextBox x:Name="TxtYColumn" Style="{StaticResource ModernTextBoxStyle}" Grid.Row="3" Grid.Column="1" Text="1" Width="100" HorizontalAlignment="Left" Margin="10,6"
                         ToolTip="目标数据列的零基索引（第一列为 0，第二列为 1，以此类推）"/>
            </Grid>
        </Border>

        <!-- 3. 数据预览卡片区 -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Margin="0,15,0,0" Padding="15,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="📄 原始数据预览 (仅展示前 20 行)" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8" FontSize="12"/>

                <!-- 文本框作为终端输出框，背景使用控制台专用的柔和灰色，字体采用等宽编程字体 Consolas -->
                <TextBox x:Name="TxtPreview" IsReadOnly="True" 
                         VerticalScrollBarVisibility="Auto" 
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" 
                         FontFamily="Consolas" 
                         FontSize="11.5"
                         Background="#F8FAFC" 
                         BorderBrush="#DEE2E6" 
                         BorderThickness="1" 
                         Padding="8"
                         Foreground="#334155"/>
            </DockPanel>
        </Border>

        <!-- 4. 底部动作区 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="取消" Style="{StaticResource SecondaryButtonStyle}" Click="BtnCancel_Click" Width="85" Height="30" IsCancel="True" Margin="0,0,10,0"/>
            <Button Content="确认导入" Style="{StaticResource PrimaryButtonStyle}" Click="BtnImport_Click" Width="95" Height="30" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>