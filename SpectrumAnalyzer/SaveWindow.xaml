<Window x:Class="SpectrumAnalyzer.SaveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="录入标准库详细信息" 
        SizeToContent="Height" 
        Width="480" 
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize"
        Background="#F8FAFC">

    <Window.Resources>
        <!-- ========================================================== -->
        <!-- 1. 独立 ControlTemplate 声明区（规避嵌套解析冲突） -->
        <!-- ========================================================== -->

        <!-- 次要辅助/取消按钮模板 -->
        <ControlTemplate x:Key="SecondaryButtonTemplate" TargetType="Button">
            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#F8FAFC"/>
                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#94A3B8"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 成功/确认存库按钮模板 (翡翠绿高亮配色) -->
        <ControlTemplate x:Key="SuccessButtonTemplate" TargetType="Button">
            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#059669"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#047857"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 增加特征峰微型按钮模板 (轻盈浅蓝线框) -->
        <ControlTemplate x:Key="MiniButtonTemplate" TargetType="Button">
            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#EFF6FF"/>
                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#2563EB"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 删除特征峰微型按钮模板 (轻盈浅红线框) -->
        <ControlTemplate x:Key="MiniDangerButtonTemplate" TargetType="Button">
            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="BtnBorder" Property="Background" Value="#FEF2F2"/>
                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#DC2626"/>
                    <Setter Property="Cursor" Value="Hand"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ========================================================== -->
        <!-- 2. Style 平铺绑定定义区 -->
        <!-- ========================================================== -->

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template" Value="{StaticResource SecondaryButtonTemplate}"/>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template" Value="{StaticResource SuccessButtonTemplate}"/>
        </Style>

        <Style x:Key="MiniButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#BFDBFE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template" Value="{StaticResource MiniButtonTemplate}"/>
        </Style>

        <Style x:Key="MiniDangerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template" Value="{StaticResource MiniDangerButtonTemplate}"/>
        </Style>

        <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="4" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#0D6EFD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 表格精细样式定义 -->
        <Style x:Key="ModernGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F1F5F9"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource ModernGridHeader}"/>
        </Style>

        <!-- 编辑表格内容单元格样式 -->
        <Style x:Key="CenterAlignEditableCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 标题 -->
                <RowDefinition Height="Auto"/>
                <!-- 基础参数卡片 -->
                <RowDefinition Height="Auto"/>
                <!-- 特征峰卡片 -->
                <RowDefinition Height="Auto"/>
                <!-- 动作控制 -->
            </Grid.RowDefinitions>

            <!-- 1. 顶部标题 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock x:Name="TxtTitle" Text="基本信息录入" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="保存当前处理完毕的光谱与提取出的指纹特征峰至 SQLite 标准库" FontSize="11" Foreground="#6C757D" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- 2. 基础属性配置卡片 -->
            <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15,10" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="📋 标准光谱元数据" FontWeight="Bold" Foreground="#475569" FontSize="12" Margin="0,0,0,8"/>

                    <UniformGrid Columns="2">
                        <StackPanel Margin="4">
                            <TextBlock Text="标准物质名称:" Foreground="#64748B" FontSize="11" Margin="2,0,0,4"/>
                            <TextBox x:Name="TxtName" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="4">
                            <TextBlock Text="分子式 / 化学式:" Foreground="#64748B" FontSize="11" Margin="2,0,0,4"/>
                            <TextBox x:Name="TxtFormula" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="4">
                            <TextBlock Text="CAS 登记号:" Foreground="#64748B" FontSize="11" Margin="2,0,0,4"/>
                            <TextBox x:Name="TxtCas" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                        <StackPanel Margin="4">
                            <TextBlock Text="激发波长 (nm):" Foreground="#64748B" FontSize="11" Margin="2,0,0,4"/>
                            <TextBox x:Name="TxtLaser" Style="{StaticResource ModernTextBoxStyle}" Text="532"/>
                        </StackPanel>
                        <StackPanel Margin="4" Grid.ColumnSpan="2">
                            <TextBlock Text="光栅规格 (l/mm):" Foreground="#64748B" FontSize="11" Margin="2,0,0,4"/>
                            <TextBox x:Name="TxtGrating" Style="{StaticResource ModernTextBoxStyle}"/>
                        </StackPanel>
                    </UniformGrid>

                    <StackPanel Margin="4,10,4,4">
                        <TextBlock Text="学术描述 / 样品说明 / 实测备注:" Foreground="#64748B" FontSize="11" Margin="2,0,0,4"/>

                        <!-- 采用合规的 Border 包裹，实现标准的现代扁平化圆角输入框 -->
                        <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Background="White">
                            <TextBox x:Name="TxtDesc" Height="55" TextWrapping="Wrap" AcceptsReturn="True" 
                 VerticalContentAlignment="Top" Padding="6" BorderThickness="0" Background="Transparent"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3. 特征峰编辑器卡片 -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15,10">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📊 指纹特征峰列表 (双击单元格可修改)" FontWeight="Bold" Foreground="#475569" FontSize="12" VerticalAlignment="Center"/>

                        <!-- 控制按钮面板 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="➕增加峰" Click="BtnAddPeak_Click" Style="{StaticResource MiniButtonStyle}" Width="70" Height="24" Margin="0,0,6,0"/>
                            <Button Content="删除选中" Click="BtnDeletePeak_Click" Style="{StaticResource MiniDangerButtonStyle}" Width="75" Height="24"/>
                        </StackPanel>
                    </Grid>

                    <!-- 特征峰表格 -->
                    <DataGrid x:Name="DgPeaks" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="False" 
                              CanUserAddRows="False" 
                              SelectionMode="Single"
                              Style="{StaticResource ModernDataGrid}"
                              FontSize="13" Height="180">
                        <DataGrid.Columns>
                            <!-- 波数（峰位）绑定到 X，允许双向编辑，实时更新源 -->
                            <DataGridTextColumn Header="特征峰位 (cm⁻¹)" 
                                                Binding="{Binding X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F1}}" 
                                                Width="*" 
                                                IsReadOnly="False"
                                                ElementStyle="{StaticResource CenterAlignEditableCell}"/>

                            <!-- 强度绑定到 Y -->
                            <DataGridTextColumn Header="相对强度 (%)" 
                                                Binding="{Binding Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F1}}" 
                                                Width="*" 
                                                IsReadOnly="False"
                                                ElementStyle="{StaticResource CenterAlignEditableCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- 4. 底部动作区 -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="取消返回" Style="{StaticResource SecondaryButtonStyle}" Click="BtnCancel_Click" Width="90" Height="30" Margin="0,0,10,0"/>
                <Button Content="确认归档存库" Style="{StaticResource SuccessButtonStyle}" Click="BtnSave_Click" Width="110" Height="30"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>